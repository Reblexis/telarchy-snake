# systemd --user unit for the snake service (docs/snake.md, "Operation").
# Install on the box as the telarchy user: bash deploy/install.sh
[Unit]
Description=telarchy-snake: the futarchy snake operator and board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/telarchy-snake
EnvironmentFile=%h/src/telarchy-snake/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
# The fleet box runs benches and scans that starve a 2-core host at times
# (2026-09-11: load 34, timers firing minutes late, steps lapsing). The
# operator must decide inside its minute, so it outweighs its neighbours
# within the user's cgroup and keeps a memory floor.
CPUWeight=1000
IOWeight=500
MemoryLow=256M
StandardOutput=append:%h/logs/telarchy-snake.log
StandardError=append:%h/logs/telarchy-snake.log

[Install]
WantedBy=default.target
