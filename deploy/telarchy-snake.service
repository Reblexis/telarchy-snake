# systemd --user unit for the snake service (docs/snake.md, "Operation").
# Install on the box as the telarchy user: bash deploy/install.sh
[Unit]
Description=telarchy-snake: the futarchy snake operator and board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/telarchy-snake
EnvironmentFile=%h/src/telarchy-snake/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
StandardOutput=append:%h/logs/telarchy-snake.log
StandardError=append:%h/logs/telarchy-snake.log

[Install]
WantedBy=default.target
